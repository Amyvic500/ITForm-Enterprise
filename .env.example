# ITForm Enterprise - Environment Configuration
# Copy this file to .env and update with your settings

# Application Settings
APP_NAME=ITForm Enterprise
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/itform
APP_KEY=SomeRandomString32CharactersLongForCryption

# Database Configuration
# Choose: sqlserver (primary) or mysql
DB_CONNECTION=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ITForm_DB
DB_USER=sa
DB_PASS=YourDatabasePasswordHere

# Alternative MySQL Configuration (if using MySQL)
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=itform_db
# DB_USER=root
# DB_PASS=

# Session Configuration
SESSION_TIMEOUT=30

# Email Configuration (SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDRESS=noreply@itform.local
MAIL_FROM_NAME=ITForm System
ENABLE_EMAIL_NOTIFICATIONS=true

# Logging Configuration
ENABLE_LOGGING=true
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif

# Approval Configuration
APPROVAL_TIMEOUT_DAYS=7
APPROVAL_REMINDER_DAYS=3
APPROVAL_AUTO_ESCALATE=true

# Security
CSRF_PROTECTION=true
SESSION_SECURE_COOKIES=false

# Timezone
TIMEZONE=Africa/Lagos

# Features
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API=false
ENABLE_SMS_NOTIFICATIONS=false
